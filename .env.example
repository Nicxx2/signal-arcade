# Signal Arcade is paper-only. It never accepts wallet keys or seed phrases.
SIGNAL_ARCADE_BIND=127.0.0.1
SIGNAL_ARCADE_PORT=8765
SIGNAL_ARCADE_DATA_DIR=./data
SIGNAL_ARCADE_LOG_LEVEL=INFO
SIGNAL_ARCADE_DEMO_MODE=false

# Docker/Compose image and host publishing. The LAN-friendly Compose default is
# 0.0.0.0; use 127.0.0.1 when only the Docker host or a local proxy should connect.
SIGNAL_ARCADE_IMAGE=nicxx2/signal-arcade:latest
SIGNAL_ARCADE_HOST_IP=0.0.0.0
SIGNAL_ARCADE_HOST_PORT=8765
# Optional host path for app state. Blank keeps the Docker named volume. A relative path is
# resolved beside the Compose file; for example, ./data stores it with this project.
SIGNAL_ARCADE_DATA_SOURCE=

# Required by Docker and whenever the app binds outside localhost.
SIGNAL_ARCADE_ADMIN_PASSWORD=

# Public defaults work without keys. Optional keys improve capacity. These values are fallbacks;
# Settings -> Data providers can override them locally without rebuilding the container.
SIGNAL_ARCADE_SOLANA_HTTP=https://api.mainnet-beta.solana.com
SIGNAL_ARCADE_SOLANA_WS=wss://api.mainnet-beta.solana.com
SIGNAL_ARCADE_JUPITER_BASE=https://api.jup.ag
SIGNAL_ARCADE_JUPITER_API_KEY=

# Optional retention tuning for small home servers.
SIGNAL_ARCADE_CANDIDATE_WINDOW_MINUTES=30
SIGNAL_ARCADE_RAW_TRADE_RETENTION_HOURS=6
SIGNAL_ARCADE_EQUITY_SAMPLE_SECONDS=5
SIGNAL_ARCADE_POSITION_MARK_STALE_SECONDS=90
SIGNAL_ARCADE_EVENT_QUEUE_MAX=10000
SIGNAL_ARCADE_EVENT_BATCH_SIZE=250
SIGNAL_ARCADE_EVENT_BATCH_WAIT_MS=25
SIGNAL_ARCADE_DECISION_COOLDOWN_SECONDS=5
SIGNAL_ARCADE_STALE_MARKET_SECONDS=20
SIGNAL_ARCADE_ENTRY_LATENCY_MS=850
SIGNAL_ARCADE_EXIT_LATENCY_MS=1100
SIGNAL_ARCADE_NETWORK_FEE_LAMPORTS=5000
SIGNAL_ARCADE_PRIORITY_FEE_LAMPORTS=25000
SIGNAL_ARCADE_PUMP_FEE_BPS=125

# Docker Compose now includes a private, CPU-first Ollama service. Leave the URL blank to use it.
# Models are downloaded later from Settings and persist in their own volume outside the app's
# storage limit. For a native install use http://127.0.0.1:11434; for an external container use
# its service URL. Ollama's API is not published to the LAN by the supplied stack.
SIGNAL_ARCADE_OLLAMA_URL=
SIGNAL_ARCADE_OLLAMA_MODEL=qwen3.5:2b
SIGNAL_ARCADE_OLLAMA_VERSION=0.33.1
SIGNAL_ARCADE_MODEL_SOURCE=
SIGNAL_ARCADE_OLLAMA_ACCELERATOR=cpu
SIGNAL_ARCADE_OLLAMA_CONTEXT_LENGTH=2048
SIGNAL_ARCADE_OLLAMA_KEEP_ALIVE=10m
SIGNAL_ARCADE_OLLAMA_MAX_QUEUE=4
# Maximum llama.cpp cross-request prompt cache in MiB. This is separate from model storage.
SIGNAL_ARCADE_OLLAMA_PROMPT_CACHE_MB=512

# Optional GPU acceleration uses an explicit overlay so a missing driver can never stop the base
# paper engine. NVIDIA: compose.nvidia.yaml. AMD ROCm on Linux: compose.amd.yaml. The ordinary
# compose.yaml remains the safe CPU fallback on Windows, Linux, Portainer, OMV, and mini PCs.
